<resources>
    <style name="WidgetStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="WidgetStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- Launchers ignore app font resources in widgets, so use the system condensed face. -->
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#FFF4F4F2</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="WidgetStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FF8B8B93</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
