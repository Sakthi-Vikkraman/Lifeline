<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="NEXT CHECK-IN"
        android:textColor="#FF8B8B93"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:text="15:00"
        android:textColor="#FFF4F4F2"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:text="0/8 REPS"
        android:textColor="#FFC8FF00"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/log_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="+ LOG"
        android:textColor="#FF0B0B0C"
        android:textSize="17sp" />
</LinearLayout>
